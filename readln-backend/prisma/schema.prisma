generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     String?  @db.VarChar(36)
  client_ip   String   @db.VarChar(45)
  user_agent  String?  @db.Text
  action      String   @db.VarChar(100)
  status_code Int
  details     Json?
  created_at  DateTime @default(now()) @db.DateTime(0)

  @@index([client_ip], map: "idx_audit_logs_client_ip")
  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created_at")
}

model bookmarks {
  user_id    String   @db.VarChar(36)
  story_id   String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.DateTime(0)
  stories    stories  @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bm_story")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bm_user")

  @@id([user_id, story_id])
  @@index([story_id], map: "fk_bm_story")
}

model chapters {
  id             String     @id @db.VarChar(36)
  story_id       String     @db.VarChar(36)
  chapter_number Int
  title          String     @db.VarChar(255)
  content        String     @db.MediumText
  word_count     Int        @default(0)
  is_deleted     Boolean    @default(false)
  created_at     DateTime   @default(now()) @db.DateTime(0)
  updated_at     DateTime   @default(now()) @db.DateTime(0)
  stories        stories    @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chapter_story")
  comments       comments[]

  @@unique([story_id, chapter_number], map: "uq_story_chapter")
  @@index([story_id, is_deleted, chapter_number], map: "idx_chapters_story_id")
}

model comments {
  id         String    @id @db.VarChar(36)
  story_id   String    @db.VarChar(36)
  chapter_id String?   @db.VarChar(36)
  user_id    String    @db.VarChar(36)
  content    String    @db.Text
  is_flagged Boolean   @default(false)
  is_deleted Boolean   @default(false)
  created_at DateTime  @default(now()) @db.DateTime(0)
  chapters   chapters? @relation(fields: [chapter_id], references: [id], onUpdate: NoAction, map: "fk_comment_chapter")
  stories    stories   @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_story")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_user")

  @@index([chapter_id], map: "fk_comment_chapter")
  @@index([user_id], map: "fk_comment_user")
  @@index([story_id, is_deleted, created_at(sort: Desc)], map: "idx_comments_story_id")
}

model genres {
  id           Int            @id @default(autoincrement())
  name         String         @unique(map: "name") @db.VarChar(50)
  slug         String         @unique(map: "slug") @db.VarChar(50)
  story_genres story_genres[]
}

model ip_blacklists {
  id            Int       @id @default(autoincrement())
  ip_address    String    @unique(map: "ip_address") @db.VarChar(45)
  reason        String    @db.VarChar(255)
  blocked_until DateTime? @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)
}

model password_resets {
  id         String   @id @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  token_hash String   @db.VarChar(255)
  expires_at DateTime @db.DateTime(0)
  used       Boolean  @default(false)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reset_user")

  @@index([user_id], map: "fk_reset_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  id         String   @id @db.VarChar(36)
  story_id   String   @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  score      Int      @db.TinyInt
  created_at DateTime @default(now()) @db.DateTime(0)
  stories    stories  @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rating_story")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_rating_user")

  @@unique([story_id, user_id], map: "uq_story_user_rating")
  @@index([user_id], map: "fk_rating_user")
}

model stories {
  id           String         @id @db.VarChar(36)
  title        String         @db.VarChar(255)
  slug         String         @unique(map: "slug") @db.VarChar(255)
  author_name  String         @db.VarChar(100)
  summary      String?        @db.Text
  view_count   BigInt         @default(0)
  is_deleted   Boolean        @default(false)
  created_at   DateTime       @default(now()) @db.DateTime(0)
  updated_at   DateTime       @default(now()) @db.DateTime(0)
  bookmarks    bookmarks[]
  chapters     chapters[]
  comments     comments[]
  ratings      ratings[]
  story_genres story_genres[]

  @@index([is_deleted, updated_at(sort: Desc)], map: "idx_stories_updated_at")
}

model story_genres {
  story_id String  @db.VarChar(36)
  genre_id Int
  genres   genres  @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sg_genre")
  stories  stories @relation(fields: [story_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_sg_story")

  @@id([story_id, genre_id])
  @@index([genre_id], map: "fk_sg_genre")
}

model system_settings {
  setting_key   String   @id @db.VarChar(50)
  setting_value String   @db.VarChar(255)
  updated_at    DateTime @default(now()) @db.DateTime(0)
}

model users {
  id                    String            @id @db.VarChar(36)
  username              String            @unique(map: "username") @db.VarChar(50)
  email                 String            @unique(map: "email") @db.VarChar(100)
  password_hash         String            @db.VarChar(255)
  role                  users_role        @default(READER)
  failed_login_attempts Int               @default(0)
  lockout_until         DateTime?         @db.DateTime(0)
  created_at            DateTime          @default(now()) @db.DateTime(0)
  updated_at            DateTime          @default(now()) @db.DateTime(0)
  bookmarks             bookmarks[]
  comments              comments[]
  password_resets       password_resets[]
  ratings               ratings[]
}

enum users_role {
  READER
  AUTHOR
  ADMIN
}
